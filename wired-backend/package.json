{
  "name": "wired-backend",
  "version": "0.1.0",
  "description": "Socket.IO backend for Wired collaborative canvas",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "socket.io",
    "redis",
    "collaboration",
    "canvas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
